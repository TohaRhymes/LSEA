# LSEA experiment paths — copy to .env and fill in your values
# .env is in .gitignore and will NOT be pushed to GitHub.

# Conda activation script (comment out if not needed)
CONDA_ACTIVATE=/path/to/anaconda3/bin/activate

# PLINK binary directory
PLINK_DIR=/path/to/plink

# bioGWAS test data root
BIOGWAS_DATA_DIR=/path/to/bioGWAS/tests

# LD reference panels (PLINK bfile prefix)
BIOGWAS_BFILE=/path/to/bioGWAS/tests/3_pathways/in_data/test10000_filt_sim
PANUKB_BFILE=/path/to/bioGWAS/tests/data/merged_1000genomes_eur

# LSEA test data (bioGWAS experiments)
LSEA_TEST_DIR=/path/to/lsea_test

# Pan-UKB data
PANUKB_DATA_DIR=/path/to/panukb
PANUKB_LSEA_DIR=/path/to/panukb_lsea

# GENCODE GTF
GENCODE_GTF=/path/to/gencode.v37.annotation.gtf

# GMT files
GMT_C2=/path/to/c2.cp.kegg.v2023.1.Hs.symbols.gmt
GMT_GTE=/path/to/GTEx8_formatted.gmt
GMT_BCM=/path/to/blood_cell_markers.gmt
GMT_GO_BP=/path/to/c5.go.bp.v2024.1.Hs.symbols.gmt
GMT_GO_CC=/path/to/c5.go.cc.v2024.1.Hs.symbols.gmt
GMT_GO_MF=/path/to/c5.go.mf.v2024.1.Hs.symbols.gmt
